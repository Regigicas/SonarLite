<Window x:Class="SonarLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SonarLite"
        xmlns:core="clr-namespace:SonarLite.Core;assembly=SonarLite.Core"
        Title="Sonar Lite"
        Icon="app.ico"
        Width="940" Height="600" MinWidth="700" MinHeight="460"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True">

    <Window.Resources>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <Style x:Key="ChannelHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="IconFont" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <!-- Preset in a list: favorites carry a star (Sonar lists them first). -->
        <DataTemplate x:Key="PresetItemTemplate" DataType="{x:Type core:ConfigSummary}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconFont}" FontSize="11" Text="&#xE735;"
                           Margin="0,0,6,0" VerticalAlignment="Center" Opacity="0.8"
                           Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>

        <!-- One mixer column: name, value, slider, mute, output device, preset.
             Combo items trim with an ellipsis: device names and translations vary in length. -->
        <DataTemplate x:Key="ChannelTemplate" DataType="{x:Type local:ChannelViewModel}">
            <Border Width="130" Margin="4" Padding="8" CornerRadius="6"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding DisplayName}" Style="{StaticResource ChannelHeader}" />
                    <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,2,0,6" Opacity="0.75"
                               Text="{Binding VolumeText}" />

                    <ComboBox DockPanel.Dock="Bottom" Margin="0,6,0,0" ItemsSource="{Binding Presets}"
                              SelectedItem="{Binding SelectedPreset}"
                              ToolTip="Preset de ecualización" MaxDropDownHeight="420"
                              ItemTemplate="{StaticResource PresetItemTemplate}"
                              Visibility="{Binding IsMaster, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ComboBox DockPanel.Dock="Bottom" Margin="0,6,0,0" ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              ToolTip="{Binding SelectedDevice.FriendlyName}"
                              Visibility="{Binding IsMaster, Converter={StaticResource InverseBoolToVisibility}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FriendlyName}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ToggleButton DockPanel.Dock="Bottom" Margin="0,8,0,0" HorizontalAlignment="Center"
                                  IsChecked="{Binding Muted}" ToolTip="Silenciar">
                        <Grid>
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE767;"
                                       Visibility="{Binding Muted, Converter={StaticResource InverseBoolToVisibility}}" />
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE74F;"
                                       Visibility="{Binding Muted, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </ToggleButton>

                    <Slider Orientation="Vertical" HorizontalAlignment="Center" Minimum="0" Maximum="100"
                            SmallChange="1" LargeChange="5" IsMoveToPointEnabled="True"
                            Value="{Binding Volume}" />
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- Status bar -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <CheckBox DockPanel.Dock="Right" Content="Mostrar dB" IsChecked="{Binding ShowDecibels}"
                      ToolTip="Muestra la atenuación real de cada canal en dB en lugar del porcentaje" />
            <!-- Optional channels: turning one off removes its virtual device from Windows -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,24,0"
                        IsEnabled="{Binding IsConnected}">
                <TextBlock Text="Canales:" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.8" />
                <ItemsControl ItemsSource="{Binding OptionalChannels}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ChannelViewModel}">
                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsEnabled}" MinWidth="0" Margin="0,0,16,0"
                                      ToolTip="Activa o desactiva el canal en Sonar; desactivado, su dispositivo virtual desaparece de Windows" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#D13438" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="#6CCB5F" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding Status}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <TabControl>
            <TabItem Header="Mezclador">
                <DockPanel Margin="0,8,0,0">
                    <!-- ChatMix -->
                    <Border DockPanel.Dock="Bottom" Margin="4,8,4,0" Padding="12,8" CornerRadius="6"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            IsEnabled="{Binding ChatMixEnabled}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ChatMix" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <!-- MinWidth keeps the slider from jumping as the numbers change width -->
                            <TextBlock Grid.Column="1" Text="{Binding ChatMixGameText}" VerticalAlignment="Center"
                                       Margin="0,0,8,0" MinWidth="100" TextAlignment="Right" />
                            <Slider Grid.Column="2" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10"
                                    IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                    Value="{Binding ChatMix}" />
                            <TextBlock Grid.Column="3" Text="{Binding ChatMixChatText}" VerticalAlignment="Center"
                                       Margin="8,0,0,0" MinWidth="100" />
                        </Grid>
                    </Border>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Content="{Binding Master}" ContentTemplate="{StaticResource ChannelTemplate}" />
                            <Rectangle Width="1" Margin="6,12" Fill="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <ItemsControl ItemsSource="{Binding Channels}" ItemTemplate="{StaticResource ChannelTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="Presets">
                <TabItem.Resources>
                    <!-- Rows of a preset card, one template per kind of setting.
                         Minimum/Maximum go before Value so the slider never coerces a real value. -->
                    <!-- The Fluent slider looks the same when disabled: dim the whole row instead. -->
                    <Style x:Key="DimWhenDisabled" TargetType="FrameworkElement">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <DataTemplate DataType="{x:Type local:SliderSetting}">
                        <Grid Margin="0,4,0,0" IsEnabled="{Binding IsEnabled}" Style="{StaticResource DimWhenDisabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Slider Grid.Column="1" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                    Minimum="{Binding Minimum, Mode=OneTime}" Maximum="{Binding Maximum, Mode=OneTime}"
                                    SmallChange="{Binding SmallChange, Mode=OneTime}" LargeChange="{Binding LargeChange, Mode=OneTime}"
                                    Value="{Binding Value}" />
                            <TextBlock Grid.Column="2" Text="{Binding ValueText}" VerticalAlignment="Center"
                                       TextAlignment="Right" Opacity="0.8" />
                        </Grid>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type local:ToggleSetting}">
                        <CheckBox Margin="0,6,0,0" Content="{Binding Label}" IsChecked="{Binding Value}" IsEnabled="{Binding IsEnabled}" />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type local:ChoiceSetting}">
                        <DockPanel Margin="0,6,0,0" IsEnabled="{Binding IsEnabled}" Style="{StaticResource DimWhenDisabled}">
                            <TextBlock Width="80" Text="{Binding Label}" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label" />
                        </DockPanel>
                    </DataTemplate>
                </TabItem.Resources>

                <DockPanel Margin="0,8,0,0" DataContext="{Binding Editor}" IsEnabled="{Binding DataContext.IsConnected, RelativeSource={RelativeSource AncestorType=Window}}">
                    <!-- Channel, preset and preset management -->
                    <WrapPanel DockPanel.Dock="Top" Margin="4,0,4,0">
                        <ComboBox Width="130" Margin="0,0,8,8" ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}"
                                  DisplayMemberPath="DisplayName" ToolTip="Canal" />
                        <ComboBox Width="240" Margin="0,0,8,8" ItemsSource="{Binding Channel.Presets}"
                                  SelectedItem="{Binding Channel.SelectedPreset}" MaxDropDownHeight="420"
                                  ItemTemplate="{StaticResource PresetItemTemplate}"
                                  ToolTip="Preset seleccionado en el canal" />
                        <ToggleButton Margin="0,0,16,8" Padding="8,4" IsChecked="{Binding IsFavorite}"
                                      IsEnabled="{Binding HasConfig}" ToolTip="Favorito: aparece al principio de la lista">
                            <TextBlock Style="{StaticResource IconFont}" FontSize="14" Text="&#xE734;" />
                        </ToggleButton>
                        <Button Content="Nuevo" Margin="0,0,6,8" Command="{Binding NewCommand}"
                                ToolTip="Crea un preset con los ajustes neutros de Sonar" />
                        <Button Content="Duplicar" Margin="0,0,6,8" Command="{Binding DuplicateCommand}" IsEnabled="{Binding HasConfig}"
                                ToolTip="Crea una copia del preset con sus ajustes actuales" />
                        <Button Content="Renombrar" Margin="0,0,6,8" Command="{Binding RenameCommand}" IsEnabled="{Binding CanRename}"
                                ToolTip="Los presets de SteelSeries no se pueden renombrar" />
                        <Button Content="Restablecer" Margin="0,0,6,8" Command="{Binding ResetCommand}" IsEnabled="{Binding HasConfig}"
                                ToolTip="Vuelve a los valores predeterminados del preset" />
                        <Button Content="Borrar" Margin="0,0,6,8" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}"
                                ToolTip="Solo se pueden borrar presets propios, y cada canal conserva al menos uno" />
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="4,0,4,8" Opacity="0.75" TextWrapping="Wrap" Text="{Binding PresetInfo}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasConfig, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PresetSection}">
                                    <Border Width="290" Margin="4" Padding="12,10" CornerRadius="6"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <CheckBox Content="{Binding Title}" IsChecked="{Binding Toggle.Value}" FontWeight="SemiBold"
                                                      Visibility="{Binding HasToggle, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,4"
                                                       Visibility="{Binding HasToggle, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <ItemsControl ItemsSource="{Binding Items}" Focusable="False" />
                                            <TextBlock Text="{Binding Note}" Margin="0,8,0,0" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="Aplicaciones">
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top" Margin="4,0,4,8" Opacity="0.75" TextWrapping="Wrap"
                               Text="Elige a qué canal de Sonar va cada aplicación. En las que no tienen audio ahora, el cambio se aplica en cuanto vuelvan a sonar. «Siempre» lo reaplica en cada arranque (útil si la app cambia de ruta al actualizarse, como Discord)." />

                    <!-- Add an app that has never played audio yet -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="4,8,4,0">
                        <TextBlock DockPanel.Dock="Left" Text="Añadir app (nombre del proceso):" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button DockPanel.Dock="Right" Content="Añadir" Margin="8,0,0,0" Command="{Binding AddAppCommand}" />
                        <TextBox Text="{Binding NewAppName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Por ejemplo: Discord o Discord.exe">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddAppCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Apps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:AppViewModel}">
                                    <Border Margin="4,2" Padding="12,6" CornerRadius="6"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="36" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Name}" ToolTip="{Binding ProcessName}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                <Setter Property="Opacity" Value="0.6" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding Detail}" VerticalAlignment="Center"
                                                       Margin="8,0,12,0" Opacity="0.6" TextTrimming="CharacterEllipsis" MaxWidth="320"
                                                       ToolTip="{Binding Detail}" />
                                            <ComboBox Grid.Column="2" ItemsSource="{Binding Options}" DisplayMemberPath="Name"
                                                      SelectedItem="{Binding Channel}" />
                                            <CheckBox Grid.Column="3" Content="Siempre" Margin="12,0,0,0" IsChecked="{Binding IsAlways}"
                                                      ToolTip="Volver a poner la app en este canal cada vez que empiece a sonar" />
                                            <Button Grid.Column="4" Margin="4,0,0,0" Padding="6,2" Command="{Binding RemoveRuleCommand}"
                                                    ToolTip="{Binding RemoveTooltip}"
                                                    Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Style="{StaticResource IconFont}" FontSize="12" Text="&#xE711;" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
