<Window x:Class="SonarLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SonarLite"
        Title="Sonar Lite"
        Icon="app.ico"
        Width="940" Height="600" MinWidth="700" MinHeight="460"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True">

    <Window.Resources>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <Style x:Key="ChannelHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="IconFont" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <!-- One mixer column: name, value, slider, mute, output device, preset.
             Combo items trim with an ellipsis: device names and translations vary in length. -->
        <DataTemplate x:Key="ChannelTemplate" DataType="{x:Type local:ChannelViewModel}">
            <Border Width="130" Margin="4" Padding="8" CornerRadius="6"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding DisplayName}" Style="{StaticResource ChannelHeader}" />
                    <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,2,0,6" Opacity="0.75"
                               Text="{Binding VolumeText}" />

                    <ComboBox DockPanel.Dock="Bottom" Margin="0,6,0,0" ItemsSource="{Binding Presets}"
                              SelectedItem="{Binding SelectedPreset}"
                              ToolTip="Preset de ecualización" MaxDropDownHeight="420"
                              Visibility="{Binding IsMaster, Converter={StaticResource InverseBoolToVisibility}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox DockPanel.Dock="Bottom" Margin="0,6,0,0" ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              ToolTip="{Binding SelectedDevice.FriendlyName}"
                              Visibility="{Binding IsMaster, Converter={StaticResource InverseBoolToVisibility}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FriendlyName}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ToggleButton DockPanel.Dock="Bottom" Margin="0,8,0,0" HorizontalAlignment="Center"
                                  IsChecked="{Binding Muted}" ToolTip="Silenciar">
                        <Grid>
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE767;"
                                       Visibility="{Binding Muted, Converter={StaticResource InverseBoolToVisibility}}" />
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE74F;"
                                       Visibility="{Binding Muted, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </ToggleButton>

                    <Slider Orientation="Vertical" HorizontalAlignment="Center" Minimum="0" Maximum="100"
                            SmallChange="1" LargeChange="5" IsMoveToPointEnabled="True"
                            Value="{Binding Volume}" />
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- Status bar -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <CheckBox DockPanel.Dock="Right" Content="Mostrar dB" IsChecked="{Binding ShowDecibels}"
                      ToolTip="Muestra la atenuación real de cada canal en dB en lugar del porcentaje" />
            <!-- Optional channels: turning one off removes its virtual device from Windows -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,24,0"
                        IsEnabled="{Binding IsConnected}">
                <TextBlock Text="Canales:" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.8" />
                <ItemsControl ItemsSource="{Binding OptionalChannels}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ChannelViewModel}">
                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsEnabled}" MinWidth="0" Margin="0,0,16,0"
                                      ToolTip="Activa o desactiva el canal en Sonar; desactivado, su dispositivo virtual desaparece de Windows" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#D13438" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="#6CCB5F" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding Status}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <TabControl>
            <TabItem Header="Mezclador">
                <DockPanel Margin="0,8,0,0">
                    <!-- ChatMix -->
                    <Border DockPanel.Dock="Bottom" Margin="4,8,4,0" Padding="12,8" CornerRadius="6"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            IsEnabled="{Binding ChatMixEnabled}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ChatMix" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <!-- MinWidth keeps the slider from jumping as the numbers change width -->
                            <TextBlock Grid.Column="1" Text="{Binding ChatMixGameText}" VerticalAlignment="Center"
                                       Margin="0,0,8,0" MinWidth="100" TextAlignment="Right" />
                            <Slider Grid.Column="2" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10"
                                    IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                    Value="{Binding ChatMix}" />
                            <TextBlock Grid.Column="3" Text="{Binding ChatMixChatText}" VerticalAlignment="Center"
                                       Margin="8,0,0,0" MinWidth="100" />
                        </Grid>
                    </Border>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Content="{Binding Master}" ContentTemplate="{StaticResource ChannelTemplate}" />
                            <Rectangle Width="1" Margin="6,12" Fill="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <ItemsControl ItemsSource="{Binding Channels}" ItemTemplate="{StaticResource ChannelTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="Aplicaciones">
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top" Margin="4,0,4,8" Opacity="0.75" TextWrapping="Wrap"
                               Text="Elige a qué canal de Sonar va cada aplicación. En las que no tienen audio ahora, el cambio se aplica en cuanto vuelvan a sonar. «Siempre» lo reaplica en cada arranque (útil si la app cambia de ruta al actualizarse, como Discord)." />

                    <!-- Add an app that has never played audio yet -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="4,8,4,0">
                        <TextBlock DockPanel.Dock="Left" Text="Añadir app (nombre del proceso):" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button DockPanel.Dock="Right" Content="Añadir" Margin="8,0,0,0" Command="{Binding AddAppCommand}" />
                        <TextBox Text="{Binding NewAppName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Por ejemplo: Discord o Discord.exe">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddAppCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Apps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:AppViewModel}">
                                    <Border Margin="4,2" Padding="12,6" CornerRadius="6"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="36" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Name}" ToolTip="{Binding ProcessName}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                <Setter Property="Opacity" Value="0.6" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding Detail}" VerticalAlignment="Center"
                                                       Margin="8,0,12,0" Opacity="0.6" TextTrimming="CharacterEllipsis" MaxWidth="320"
                                                       ToolTip="{Binding Detail}" />
                                            <ComboBox Grid.Column="2" ItemsSource="{Binding Options}" DisplayMemberPath="Name"
                                                      SelectedItem="{Binding Channel}" />
                                            <CheckBox Grid.Column="3" Content="Siempre" Margin="12,0,0,0" IsChecked="{Binding IsAlways}"
                                                      ToolTip="Volver a poner la app en este canal cada vez que empiece a sonar" />
                                            <Button Grid.Column="4" Margin="4,0,0,0" Padding="6,2" Command="{Binding RemoveRuleCommand}"
                                                    ToolTip="{Binding RemoveTooltip}"
                                                    Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Style="{StaticResource IconFont}" FontSize="12" Text="&#xE711;" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
