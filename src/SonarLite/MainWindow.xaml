<Window x:Class="SonarLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SonarLite"
        Title="Sonar Lite"
        Width="940" Height="600" MinWidth="700" MinHeight="460"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True">

    <Window.Resources>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <Style x:Key="ChannelHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="IconFont" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <!-- One mixer column: name, value, slider, mute, output device, preset. -->
        <DataTemplate x:Key="ChannelTemplate" DataType="{x:Type local:ChannelViewModel}">
            <Border Width="130" Margin="4" Padding="8" CornerRadius="6"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding DisplayName}" Style="{StaticResource ChannelHeader}" />
                    <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,2,0,6" Opacity="0.75"
                               Text="{Binding Volume, StringFormat={}{0:0} %}" />

                    <ComboBox DockPanel.Dock="Bottom" Margin="0,6,0,0" ItemsSource="{Binding Presets}"
                              SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name"
                              ToolTip="Preset de ecualización" MaxDropDownHeight="420"
                              Visibility="{Binding IsMaster, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ComboBox DockPanel.Dock="Bottom" Margin="0,6,0,0" ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="FriendlyName"
                              ToolTip="{Binding SelectedDevice.FriendlyName}"
                              Visibility="{Binding IsMaster, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ToggleButton DockPanel.Dock="Bottom" Margin="0,8,0,0" HorizontalAlignment="Center"
                                  IsChecked="{Binding Muted}" ToolTip="Silenciar">
                        <Grid>
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE767;"
                                       Visibility="{Binding Muted, Converter={StaticResource InverseBoolToVisibility}}" />
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE74F;"
                                       Visibility="{Binding Muted, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </ToggleButton>

                    <Slider Orientation="Vertical" HorizontalAlignment="Center" Minimum="0" Maximum="100"
                            SmallChange="1" LargeChange="5" IsMoveToPointEnabled="True"
                            Value="{Binding Volume}" />
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#D13438" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="#6CCB5F" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding Status}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <TabControl>
            <TabItem Header="Mezclador">
                <DockPanel Margin="0,8,0,0">
                    <!-- ChatMix -->
                    <Border DockPanel.Dock="Bottom" Margin="4,8,4,0" Padding="12,8" CornerRadius="6"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            IsEnabled="{Binding ChatMixEnabled}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ChatMix" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock Grid.Column="1" Text="Juego" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider Grid.Column="2" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10"
                                    IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                    Value="{Binding ChatMix}" ToolTip="{Binding ChatMix}" />
                            <TextBlock Grid.Column="3" Text="Chat" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </Border>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Content="{Binding Master}" ContentTemplate="{StaticResource ChannelTemplate}" />
                            <Rectangle Width="1" Margin="6,12" Fill="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <ItemsControl ItemsSource="{Binding Channels}" ItemTemplate="{StaticResource ChannelTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="Aplicaciones">
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top" Margin="4,0,4,8" Opacity="0.75" TextWrapping="Wrap"
                               Text="Aplicaciones con una sesión de audio abierta. Elige a qué canal de Sonar va cada una." />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Apps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:AppViewModel}">
                                    <Border Margin="4,2" Padding="12,6" CornerRadius="6"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="180" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding DeviceName}" VerticalAlignment="Center"
                                                       Margin="8,0,12,0" Opacity="0.6" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                            <ComboBox Grid.Column="2" ItemsSource="{Binding Options}" DisplayMemberPath="Name"
                                                      SelectedItem="{Binding Channel}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
