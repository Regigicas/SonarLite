<Window x:Class="SonarLite.NameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <StackPanel Margin="16">
        <TextBlock Text="Nombre" Margin="0,0,0,6" />
        <TextBox x:Name="NameBox" TextChanged="OnTextChanged" />
        <TextBlock x:Name="ErrorText" Margin="0,6,0,0" Foreground="#D13438" TextWrapping="Wrap" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="Aceptar" IsDefault="True" MinWidth="90" Click="OnOk" />
            <Button Content="Cancelar" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
